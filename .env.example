# Required
OPENAI_API_KEY=your-key-here

# Models
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=128

# Vector store
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=documents_v2

# Chunking & retrieval
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K=5
# Drop chunks below this cosine similarity (0 disables filtering)
MIN_RELEVANCE_SCORE=0
# Number of history messages forwarded to the model (2 messages = 1 exchange)
MAX_HISTORY_MESSAGES=20

# Uploads
MAX_UPLOAD_BYTES=20971520

# CORS: the browser origin(s) allowed to call the API directly
CLIENT_URL=http://localhost:5173
# Comma-separated extra origins, e.g. https://chat.example.com
EXTRA_CLIENT_URLS=

# Optional hardening (leave empty/0 to disable)
# Require "Authorization: Bearer <token>" on every API call except /api/health
API_TOKEN=
# Per-client request limit per minute
RATE_LIMIT_PER_MINUTE=0

# Only needed when the frontend is served from a different origin than the API.
# Leave empty when using the bundled nginx proxy.
VITE_API_URL=
